FROM node:22-bookworm-slim
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
COPY . .
RUN pnpm install --frozen-lockfile && pnpm db:generate && pnpm --filter @opspilot/api build
ENV NODE_ENV=production
EXPOSE 4000
CMD ["sh", "-c", "pnpm --filter @opspilot/api exec prisma migrate deploy && node apps/api/dist/main.js"]
